{
  "name": "@auth-ts/client",
  "version": "0.1.0",
  "description": "Browser token management for @auth-ts/server.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@auth-ts/server": "workspace:*"
  },
  "peerDependencies": {
    "@auth-ts/server": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@auth-ts/server": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auth-ts/auth-ts.git",
    "directory": "packages/client"
  },
  "homepage": "https://authts.dev",
  "bugs": "https://github.com/auth-ts/auth-ts/issues",
  "keywords": [
    "auth",
    "authentication",
    "jwt",
    "jwks",
    "postgrest",
    "rls",
    "neon",
    "supabase"
  ],
  "publishConfig": {
    "access": "public"
  }
}
