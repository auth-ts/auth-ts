{
  "name": "@auth-ts/client",
  "version": "0.1.0",
  "description": "Browser token management for @auth-ts/server.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@auth-ts/server": "workspace:*"
  },
  "peerDependencies": {
    "@auth-ts/server": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@auth-ts/server": {
      "optional": true
    }
  }
