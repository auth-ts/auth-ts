{
  "name": "@auth-ts/cli",
  "version": "0.1.0",
  "description": "Command line for @auth-ts/core: generate signing keys and the JWKS to publish.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "auth-ts": "./dist/cli.js"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "keygen": "tsx src/cli.ts keygen",
    "test:lib": "vitest run",
    "test:types": "tsc -p tsconfig.json",
    "test:build": "publint --strict"
  },
  "dependencies": {
    "@auth-ts/core": "workspace:*",
    "jose": "6.2.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auth-ts/auth-ts.git",
    "directory": "packages/cli"
  },
  "homepage": "https://authts.dev",
  "bugs": "https://github.com/auth-ts/auth-ts/issues",
  "keywords": [
    "auth",
    "authentication",
    "jwt",
    "jwks",
    "keygen",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  }
}
