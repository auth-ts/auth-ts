{
  "name": "@auth-ts/server",
  "version": "0.1.0",
  "description": "Free forever JWT auth in TypeScript \u2014 callbacks to write into any database.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && bun ../../tools/build/dts-extensions.ts dist && bun scripts/check-edge-safety.ts",
    "dev": "vite build --watch & tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "jose": "6.2.9"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auth-ts/auth-ts.git",
    "directory": "packages/server"
  },
  "homepage": "https://authts.dev",
  "bugs": "https://github.com/auth-ts/auth-ts/issues",
  "keywords": [
    "auth",
    "authentication",
    "jwt",
    "jwks",
    "postgrest",
    "rls",
    "neon",
    "supabase"
  ],
  "publishConfig": {
    "access": "public"
  }
}
