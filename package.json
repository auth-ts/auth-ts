{
  "name": "auth-ts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "pnpm": ">=12.6.0"
  },
  "scripts": {
    "test": "pnpm run test:ci",
    "test:pr": "nx affected --targets=test:sherif,test:knip,test:lib,test:types,test:build,build",
    "test:ci": "nx run-many --targets=test:sherif,test:knip,test:lib,test:types,test:build,build",
    "test:sherif": "sherif",
    "test:knip": "knip",
    "test:lib": "nx affected --target=test:lib --exclude=examples/**",
    "test:types": "nx affected --target=test:types --exclude=examples/**",
    "test:build": "nx affected --target=test:build --exclude=examples/**",
    "build": "nx affected --target=build --exclude=examples/**",
    "build:all": "nx run-many --target=build --exclude=examples/**",
    "lint": "biome ci .",
    "format": "biome check --fix .",
    "release": "nx release",
    "prepare": "lefthook install"
  },
  "nx": {
    "includedScripts": [
      "test:sherif",
      "test:knip"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "happy-dom": "20.14.5",
    "knip": "6.40.0",
    "lefthook": "^2.2.0",
    "nx": "23.3.0",
    "publint": "0.3.25",
    "sherif": "1.13.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
