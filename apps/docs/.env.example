# A server the API reference's playground should send requests to.
#
# Unset, the playground is hidden: this site documents the library, not a
# deployment. Set it to a demo or to your own server while working on the docs.
# That server has to allow this origin, and GET /token authenticates from the
# refresh cookie, so it only works when the two are same-origin.
VITE_DOCS_API_URL=
