DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: npx @auth-ts/cli keygen — it prints this as a .env line and
# writes the public key set to jwks.json.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# GitHub OAuth app. Callback URL: <origin>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Neon Data API endpoint
VITE_NEON_DATA_API_URL="https://<project>.neon.tech/api/v1"
