{
  "name": "tanstack-start-neon-example",
  "private": true,
  "type": "module",
  "nx": {
    "targets": {
      "typecheck": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
