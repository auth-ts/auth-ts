{
  "name": "tanstack-start-neon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "db:push": "drizzle-kit push && node --env-file-if-exists=.env src/db/apply-sql.ts",
    "generate-types": "npx @neondatabase/neon-js gen-types --db-url \"$DATABASE_URL\" --output src/types/database.ts",
    "test:lib": "vitest run",
    "test:types": "tsc -p tsconfig.json",
    "cf-typegen": "wrangler types",
    "keygen": "auth-ts keygen"
  },
  "dependencies": {
    "@auth-ts/core": "workspace:*",
    "@heroicons/react": "^2.2.0",
    "@neondatabase/postgrest-js": "0.2.0-beta",
    "@neondatabase/serverless": "1.2.0",
    "@supabase-cache-helpers/postgrest-react-query": "1.13.9",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "dotenv": "18.0.6",
    "drizzle-orm": "1.0.0-rc.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@auth-ts/cli": "workspace:*",
    "@cloudflare/vite-plugin": "1.63.0",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "daisyui": "5.7.47",
    "drizzle-kit": "1.0.0-rc.4",
    "tailwindcss": "4.3.3",
    "vitest": "5.0.3",
    "wrangler": "4.148.0"
  }
}
