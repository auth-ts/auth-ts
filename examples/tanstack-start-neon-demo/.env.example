# Neon connection string, used server-side by the auth callbacks.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate both with: bun run keys
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
AUTH_SECRET="a-long-random-string-that-is-not-the-jwt-key"

# Absolute origin of this app. Required because OAuth redirect URIs must never
# be derived from a request header.
AUTH_BASE_URL="http://localhost:3000"

# How many reverse proxies sit in front of this app: 1 on Vercel and most PaaS,
# 0 (or unset) when it is reached directly. Per-IP rate limits key on the
# X-Forwarded-For entry this many hops from the right, so too high a number
# trusts an entry the client wrote, and 0 leaves them off rather than spoofable.
AUTH_TRUSTED_PROXIES=""

# GitHub OAuth app. Callback URL: <AUTH_BASE_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Neon Data API endpoint — the browser talks to this, never to DATABASE_URL.
VITE_NEON_DATA_API_URL="https://<project>.neon.tech/api/v1"
