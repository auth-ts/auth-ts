DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: npx @auth-ts/cli keygen — it prints this and AUTH_SECRET as
# .env lines, and writes the public key set to jwks.json.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Keys the magic-code HMAC and signs the OAuth state cookie.
# openssl rand -hex 32
AUTH_SECRET=""

# How many reverse proxies sit in front of this app: 1 on Vercel and most PaaS.
# Leave it unset when the app is reached directly. Per-IP rate limits key on the
# X-Forwarded-For entry this many hops from the right, so too high a number
# trusts an entry the client wrote; unset leaves them off rather than spoofable.
# Must be a plain whole number when set.
# AUTH_TRUSTED_PROXIES="1"

# GitHub OAuth app. Callback URL: <origin>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Neon Data API endpoint
VITE_NEON_DATA_API_URL="https://<project>.neon.tech/api/v1"
